# Пример конфигурации nginx для https://tregubovvn.ru/kafedra-assistant
#
# Приложение — статические файлы (Next.js export), Node на сервере не нужен.
# Каталог сайта: /var/www/html/kafedra-assistant
#
# Установка:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/tregubovvn.ru
#   sudo ln -s /etc/nginx/sites-available/tregubovvn.ru /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# HTTPS: sudo certbot --nginx -d tregubovvn.ru

server {
    listen 80;
    server_name tregubovvn.ru www.tregubovvn.ru;

    # Остальной сайт — как настроен сейчас (статика, другие приложения).
    # root /var/www/html;
    # location / { try_files $uri $uri/ =404; }

    # Не отдавать dotfiles (.env с паролем БД, .git и т.п.)
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Канонический адрес без слэша: Next собирает ссылки от /kafedra-assistant
    location = /kafedra-assistant {
        return 301 /kafedra-assistant/;
    }

    # Статика приложения
    location /kafedra-assistant/ {
        root /var/www/html;
        index index.html;
        try_files $uri $uri/ /kafedra-assistant/index.html;
    }

    # Конфиг (anon key, общий пароль) правится на сервере — не кэшируем
    location = /kafedra-assistant/config.js {
        root /var/www/html;
        add_header Cache-Control "no-store";
    }
}
