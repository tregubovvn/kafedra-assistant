# Пример конфигурации nginx для tregubovvn.ru
# Установка: sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/tregubovvn.ru
#            sudo ln -s /etc/nginx/sites-available/tregubovvn.ru /etc/nginx/sites-enabled/
#            sudo nginx -t && sudo systemctl reload nginx
# HTTPS: sudo certbot --nginx -d tregubovvn.ru

server {
    listen 80;
    server_name tregubovvn.ru www.tregubovvn.ru;

    # Приложение (next start -p 3000 или docker на 127.0.0.1:3000)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
