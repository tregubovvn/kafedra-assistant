generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Пользователи: заведующий кафедрой (HEAD) и преподаватели (TEACHER)
model User {
  id                     Int                    @id @default(autoincrement())
  email                  String                 @unique
  passwordHash           String
  fullName               String
  role                   String // HEAD | TEACHER
  createdAt              DateTime               @default(now())
  sessions               Session[]
  works                  Work[]
  initiatedReplacements  Replacement[]          @relation("Initiator")
  substitutedReplacements Replacement[]         @relation("Substitute")
  assignmentStatuses     AssignmentStatus[]
  replacementRequests    ReplacementRequest[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Выполненные работы преподавателей
model Work {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD
  type          String // TEACHING | TEACHING_METHODICAL | ORG_METHODICAL | RESEARCH | EDUCATIONAL
  description   String
  newsUrl       String?
  replacementId Int? // ссылка на замену, если запись создана автоматически
  autoGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, date])
}

// Поручения заведующего кафедрой
model Assignment {
  id          Int                @id @default(autoincrement())
  description String
  dueDate     String // YYYY-MM-DD
  forAll      Boolean            @default(false)
  createdBy   Int
  createdAt   DateTime           @default(now())
  statuses    AssignmentStatus[]

  @@index([dueDate])
}

// Отметки исполнения по каждому адресату
model AssignmentStatus {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  teacherId    Int
  teacher      User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  completed    Boolean    @default(false)
  completedAt  DateTime?

  @@unique([assignmentId, teacherId])
}

// Замены занятий
model Replacement {
  id             Int                   @id @default(autoincrement())
  discipline     String
  groupId        String
  kind           String // лекц | прак | лаб
  room           String?
  lessonDate     String // YYYY-MM-DD
  pairNumber     Int
  initiatorId    Int
  initiator      User                  @relation("Initiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  substituteId   Int?
  substitute     User?                 @relation("Substitute", fields: [substituteId], references: [id], onDelete: SetNull)
  status         String                @default("SEARCHING") // SEARCHING | FOUND | CANCELLED
  assignedByHead Boolean               @default(false)
  createdAt      DateTime              @default(now())
  requests       ReplacementRequest[]

  @@index([lessonDate])
}

// Просьбы о замене, отправленные кандидатам
model ReplacementRequest {
  id            Int         @id @default(autoincrement())
  replacementId Int
  replacement   Replacement @relation(fields: [replacementId], references: [id], onDelete: Cascade)
  teacherId     Int
  teacher       User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  status        String      @default("PENDING") // PENDING | ACCEPTED | CANCELLED | DECLINED
  createdAt     DateTime    @default(now())

  @@unique([replacementId, teacherId])
}

// Кэш расписаний (преподаватели и группы)
model ScheduleEntry {
  id          Int     @id @default(autoincrement())
  ownerType   String // TEACHER | GROUP
  ownerId     String // id преподавателя (строкой) или название группы
  date        String // YYYY-MM-DD
  pairNumber  Int
  discipline  String
  kind        String
  groupId     String
  room        String?
  teacherName String? // для записей групп: кто ведёт

  @@index([ownerType, ownerId, date])
}

// Настройки приложения (singleton, id = 1)
model Settings {
  id             Int    @id @default(1)
  deepseekApiKey String @default("")
}

// Журнал исходящих писем (в прототипе письма не отправляются, а логируются)
model MailLog {
  id        Int      @id @default(autoincrement())
  toEmail   String
  toName    String
  type      String
  subject   String
  body      String
  createdAt DateTime @default(now())
}
