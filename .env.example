# Подключение к PostgreSQL в Supabase
# Проект: jxhwppkpymdzgsqhmxgn
# https://supabase.com/dashboard/project/jxhwppkpymdzgsqhmxgn
#
# Где взять строки: Supabase → Project Settings → Database → Connection string
# (кнопка «Connect» в шапке проекта). Берите вариант «Session pooler» (порт 5432):
# он работает по IPv4 и поддерживает DDL, поэтому годится и для приложения, и для
# `prisma db push`.
#
# <PASSWORD> — пароль БД, заданный при создании проекта
# (сбросить: Dashboard → Database → Reset database password).
# <REGION> — регион проекта, например eu-central-1, us-east-1
# (виден в той же строке подключения в Dashboard).

DATABASE_URL="postgresql://postgres.jxhwppkpymdzgsqhmxgn:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"
DIRECT_URL="postgresql://postgres.jxhwppkpymdzgsqhmxgn:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"

# Если для приложения нужен transaction pooler (порт 6543, больше соединений):
# DATABASE_URL="postgresql://postgres.jxhwppkpymdzgsqhmxgn:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL при этом оставьте на порту 5432 — миграции и db push через 6543 не работают.

# Ключ DeepSeek в .env не нужен: он задаётся в интерфейсе (Настройки → DeepSeek).
